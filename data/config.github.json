{
  "ai": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "languages": [
      "en"
    ],
    "analysis_concurrency": 4,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 6.0,
        "topic_dedup": false
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 200,
      "category": "hn",
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "Latent Space",
        "url": "https://www.latent.space/feed",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "tech-news"
      },
      {
        "name": "The Pragmatic Engineer",
        "url": "https://newsletter.pragmaticengineer.com/feed",
        "enabled": true,
        "category": "backend",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "ByteByteGo",
        "url": "https://blog.bytebytego.com/feed",
        "enabled": true,
        "category": "backend",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "backend",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Lobsters",
        "url": "https://lobste.rs/rss",
        "enabled": true,
        "category": "backend",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "ExperiencedDevs",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 150,
          "category": "career",
          "profile": "tech-news"
        },
        {
          "subreddit": "SaaS",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "category": "saas",
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 150,
          "category": "ai-tools",
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 15,
    "profile_order": [
      "tech-news",
      "tech-blog"
    ],
    "category_groups": {
      "ai": {
        "limit": 5,
        "categories": [
          "ai-tools"
        ]
      },
      "backend": {
        "limit": 4,
        "categories": [
          "backend"
        ]
      },
      "business": {
        "limit": 3,
        "categories": [
          "saas",
          "career"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 4
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "first",
    "platform": "discord",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "en"
    ],
    "request_body": {
      "content": "**#{message_title}**\n\n#{summary?limit=1800&split=\n}"
    }
  }
}
