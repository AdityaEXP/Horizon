{
  "ai": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "languages": [
      "en"
    ],
    "analysis_concurrency": 4,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "builder",
    "profile_settings": {
      "builder": {
        "threshold": 5.5,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 60,
      "min_score": 100,
      "category": "headlines",
      "profile": "builder"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "builder"
      },
      {
        "name": "Latent Space",
        "url": "https://www.latent.space/feed",
        "enabled": true,
        "category": "ai-tools",
        "profile": "builder"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "money",
        "profile": "builder"
      },
      {
        "name": "The Pragmatic Engineer",
        "url": "https://newsletter.pragmaticengineer.com/feed",
        "enabled": true,
        "category": "career",
        "profile": "builder",
        "content_extractor": "trafilatura"
      },
      {
        "name": "ByteByteGo",
        "url": "https://blog.bytebytego.com/feed",
        "enabled": true,
        "category": "backend",
        "profile": "builder",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "backend",
        "profile": "builder",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Lobsters",
        "url": "https://lobste.rs/rss",
        "enabled": true,
        "category": "backend",
        "profile": "builder"
      },
      {
        "name": "Show HN",
        "url": "https://hnrss.org/show?points=40",
        "enabled": true,
        "category": "money",
        "profile": "builder"
      },
      {
        "name": "Ask HN",
        "url": "https://hnrss.org/ask?points=25",
        "enabled": true,
        "category": "career",
        "profile": "builder"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "ExperiencedDevs",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 150,
          "category": "career",
          "profile": "builder"
        },
        {
          "subreddit": "SaaS",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "category": "saas",
          "profile": "builder"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 150,
          "category": "ai-tools",
          "profile": "builder"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "codeforces": {
      "enabled": true,
      "min_rating": 20,
      "max_posts": 6,
      "delay_hours": 24,
      "category": "dsa",
      "profile": "builder"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 12,
    "profile_order": [
      "builder"
    ],
    "category_groups": {
      "ai": {
        "limit": 4,
        "categories": [
          "ai-tools"
        ]
      },
      "backend": {
        "limit": 3,
        "categories": [
          "backend"
        ]
      },
      "money": {
        "limit": 3,
        "categories": [
          "money"
        ]
      },
      "career": {
        "limit": 3,
        "categories": [
          "career"
        ]
      },
      "headlines": {
        "limit": 3,
        "categories": [
          "headlines"
        ]
      },
      "dsa": {
        "limit": 2,
        "categories": [
          "dsa"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "first",
    "platform": "discord",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "en"
    ],
    "request_body": {
      "content": "**#{message_title}**\n\n#{summary?limit=1800&split=\n}"
    }
  }
}
